# Dark Sentinel v2 — environment template
#
#   cp .env.example .env
#
# docker compose reads this file from the repo root for ${...} interpolation, so
# .env must exist before `docker compose up`. .env is gitignored; this file is not.

# ── Postgres ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=darksentinel
PG_USER=postgres
PG_PASSWORD=darksentinel

# Optional single-URL override. When set it wins over the PG_* variables above.
# db.py rewrites the scheme to postgresql+psycopg2:// for SQLAlchemy, so the same
# value also works for:  psql $PG_URL -f schema_v2.sql
PG_URL=postgresql://postgres:darksentinel@localhost:5432/darksentinel

# ── Tor ─────────────────────────────────────────────────────────────────────
# Tor Browser listens on 9150; a standalone tor daemon or the compose service on 9050.
TOR_SOCKS=socks5h://127.0.0.1:9050

# ── Keys ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Optional. Clearnet correlation falls back to fixtures/clearnet_obs/ without it.
# SHODAN_API_KEY=

# ── Audit ───────────────────────────────────────────────────────────────────
# Written into every scans row. Identifies who ran the action.
OPERATOR_ID=analyst-01

# ── Debug ───────────────────────────────────────────────────────────────────
# SQL_ECHO=1
