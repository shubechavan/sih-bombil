{
	"$schema": "https://biomejs.dev/schemas/1.8.0/schema.json",
	"files": {
		"ignore": [
			".next",
			"node_modules",
			"next-env.d.ts",
			"tsconfig.tsbuildinfo",
			"package-lock.json"
		]
	},
	"organizeImports": { "enabled": true },
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": { "recommended": true }
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	}
}
